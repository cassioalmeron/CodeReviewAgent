# Repository to analyze — directory where git/gh commands run (diffs and PRs).
# Leave blank to use the current directory.
REPO_DIR=

# LLM Engine configuration (options: ollama, claude, claude-code, claude-cli)
LLM_ENGINE=ollama

# Review configuration — which versioned prompt to use (prompts/review-<version>.md)
PROMPT_VERSION=v3

# Claude configuration
ANTHROPIC_API_KEY=your-key-here
ANTHROPIC_MODEL=

# Ollama configuration
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=

# Claude Code configuration — uses the locally installed, logged-in Claude CLI and its
# subscription instead of the metered API (no API key needed). Two engines share this:
#   claude-code : via the ClaudeAgentSdk NuGet package
#   claude-cli  : drives the CLI directly (resilient to new CLI message types)
# Leave the model blank to use the CLI's default.
CLAUDE_CODE_MODEL=

# Golden set evaluation (dotnet run -- eval) — how many times each case is run
GOLDEN_RUNS=3

# LLM-as-judge (dotnet run -- judge) — quality scoring of the persisted reviews.
# The judge should be stronger than the executor, to avoid self-preference bias.
JUDGE_MODEL=claude-sonnet-4-6
RUBRIC_VERSION=v1
