 namespace Billing.Caching;

+public record struct CacheKey(string Tenant, int Version);
+
 public class VersionCache
 {
     private readonly Dictionary<CacheKey, string> _entries = [];

+    public void Store(CacheKey key, string payload) => _entries[key] = payload;
+
+    /// <summary>Stores the payload, then advances the key to the version it now points at.</summary>
+    public string? Renew(CacheKey key, string payload)
+    {
+        _entries[key] = payload;
+        key.Version++;
+        return _entries.TryGetValue(key, out var renewed) ? renewed : null;
+    }
+
     public int Count => _entries.Count;
 }
