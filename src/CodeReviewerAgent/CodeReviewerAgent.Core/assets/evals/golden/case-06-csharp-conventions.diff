diff --git a/src/Services/NotificationService.cs b/src/Services/NotificationService.cs
--- a/src/Services/NotificationService.cs
+++ b/src/Services/NotificationService.cs
@@ -14,6 +14,18 @@ public class NotificationService
     private readonly INotificationGateway _gateway;
 
+    public bool Notify(User user, string message)
+    {
+        if (user == null)
+        {
+            return false;
+        }
+
+        var subject = "Notification for " + user.Name + " (" + user.Email + ")";
+        _gateway.Send(user.Email, subject, message);
+        return true;
+    }
+
     public void Flush() => _gateway.Flush();
 }
