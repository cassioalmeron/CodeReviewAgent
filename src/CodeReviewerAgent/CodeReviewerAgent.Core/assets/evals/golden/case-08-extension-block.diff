 namespace Billing.Domain;

 public static class MoneyExtensions
 {
+    extension(decimal value)
+    {
+        public decimal RoundedToCents => Math.Round(value, 2, MidpointRounding.ToEven);
+
+        public bool IsChargeable => value > 0m;
+
+        public decimal WithTax(decimal rate) => (value * (1 + rate)).RoundedToCents;
+    }
+
     public static string ToDisplay(this decimal value) => $"{value:C}";
 }
