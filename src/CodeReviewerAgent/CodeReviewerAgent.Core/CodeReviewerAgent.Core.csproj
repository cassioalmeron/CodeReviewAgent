<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="ClaudeAgentSdk" Version="0.2.1" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.9" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.3" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="CodeReviewerAgent.Tests" />
  </ItemGroup>

  <ItemGroup>
    <None Include="prompts\**\*.md" CopyToOutputDirectory="PreserveNewest" />
    <None Include="golden\**\*" CopyToOutputDirectory="PreserveNewest" />
    <None Include="rubrics\**\*.md" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
